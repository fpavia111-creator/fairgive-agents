# Generated text (READMEs, eval cases, plugin files, clean fixtures) is compared by the --check scripts,
# so every checkout keeps LF, including a Windows clone with core.autocrlf=true.
* text=auto eol=lf
# Test exports in other languages keep their exact bytes (Windows-1252, Shift_JIS, CRLF line ends, as real exports have).
packages/*/fixtures/intl/** -text
packages/fairgive-core/test/fixtures/intl/** -text
# Calendar files use CRLF (RFC 5545).
*.ics -text
*.xlsx binary
*.png binary
*.zip binary
