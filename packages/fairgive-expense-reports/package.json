  "license": "MIT",
  "author": "Kurt Francisco",
  "engines": {
    "node": ">=20"
  },
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./package.json": "./package.json"
  },
  "bin": {
    "fairgive-expense-reports": "bin/fairgive-expense-reports.js"
  },
  "files": [
    "src",
    "bin",
    "fixtures",
    "evals",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node scripts/run-tests.cjs",
    "demo": "node bin/fairgive-expense-reports.js demo",
    "eval": "node bin/fairgive-expense-reports.js eval"
  },
  "dependencies": {
    "fairgive-core": "^0.1.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fpavia111-creator/fairgive-agents.git",
    "directory": "packages/fairgive-expense-reports"
  },
  "homepage": "https://github.com/fpavia111-creator/fairgive-agents/tree/main/packages/fairgive-expense-reports#readme",
  "bugs": {
