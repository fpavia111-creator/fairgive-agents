    ".": "./src/index.js",
    "./package.json": "./package.json"
  },
  "bin": {
    "fairgive-liquidity": "bin/fairgive-liquidity.js"
  },
  "files": [
    "src",
    "bin",
    "fixtures",
    "evals",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
