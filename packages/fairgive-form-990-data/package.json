{
  "name": "fairgive-form-990-data",
  "version": "0.1.0",
  "description": "Fairgive Form 990 Data: checks that the data behind common Form 990 schedules is complete: Schedule B contributors over the threshold with name and address, Schedule M noncash gifts, Schedule I grants with EIN, and officer hours and pay. Files nothing; not tax advice.",
  "type": "module",
  "license": "MIT",
  "author": "Kurt Francisco",
  "engines": {
    "node": ">=20"
  },
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./package.json": "./package.json"
  },
  "bin": {
    "fairgive-form-990-data": "bin/fairgive-form-990-data.js"
  },
  "files": [
    "src",
    "bin",
    "fixtures",
    "evals",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node scripts/run-tests.cjs",
    "demo": "node bin/fairgive-form-990-data.js demo",
    "eval": "node bin/fairgive-form-990-data.js eval"
  },
  "dependencies": {
    "fairgive-core": "^0.1.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fpavia111-creator/fairgive-agents.git",
    "directory": "packages/fairgive-form-990-data"
  },
  "homepage": "https://github.com/fpavia111-creator/fairgive-agents/tree/main/packages/fairgive-form-990-data#readme",
  "bugs": {
    "url": "https://github.com/fpavia111-creator/fairgive-agents/issues"
  },
  "keywords": [
    "mcp",
    "mcp-server",
    "nonprofit",
    "nonprofits",
    "fundraising",
    "fairgive",
    "form-990",
    "schedule-b",
    "nonprofit-tax-data"
  ]
}
