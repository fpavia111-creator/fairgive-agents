{
  "name": "fairgive-in-kind-gifts",
  "version": "0.1.0",
  "description": "Fairgive In-Kind Gifts: checks the in-kind gift log: gifts with no value or valuation method, values taken only from the donor, items over the appraisal and Form 8283 thresholds in your settings, services that need a recognition decision, and in-kind totals missing from the ledger.",
  "type": "module",
  "license": "MIT",
  "author": "Kurt Francisco",
  "engines": {
    "node": ">=20"
  },
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./package.json": "./package.json"
  },
  "bin": {
    "fairgive-in-kind-gifts": "bin/fairgive-in-kind-gifts.js"
  },
  "files": [
    "src",
    "bin",
    "fixtures",
    "evals",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node scripts/run-tests.cjs",
    "demo": "node bin/fairgive-in-kind-gifts.js demo",
    "eval": "node bin/fairgive-in-kind-gifts.js eval"
  },
  "dependencies": {
    "fairgive-core": "^0.1.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fpavia111-creator/fairgive-agents.git",
    "directory": "packages/fairgive-in-kind-gifts"
  },
  "homepage": "https://github.com/fpavia111-creator/fairgive-agents/tree/main/packages/fairgive-in-kind-gifts#readme",
  "bugs": {
    "url": "https://github.com/fpavia111-creator/fairgive-agents/issues"
  },
  "keywords": [
