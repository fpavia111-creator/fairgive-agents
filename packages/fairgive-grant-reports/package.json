{
  "name": "fairgive-grant-reports",
  "version": "0.1.0",
  "description": "Fairgive Grant Reports: builds the reporting calendar for every grant from its schedule and period, and flags reports overdue, due soon, final reports after the period ends and grants with no schedule. Writes a calendar file. Never submits anything to a funder.",
  "type": "module",
  "license": "MIT",
  "author": "Kurt Francisco",
  "engines": {
    "node": ">=20"
  },
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./package.json": "./package.json"
  },
  "bin": {
    "fairgive-grant-reports": "bin/fairgive-grant-reports.js"
  },
  "files": [
    "src",
    "bin",
    "fixtures",
    "evals",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node scripts/run-tests.cjs",
    "demo": "node bin/fairgive-grant-reports.js demo",
    "eval": "node bin/fairgive-grant-reports.js eval"
  },
  "dependencies": {
    "fairgive-core": "^0.1.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fpavia111-creator/fairgive-agents.git",
    "directory": "packages/fairgive-grant-reports"
  },
  "homepage": "https://github.com/fpavia111-creator/fairgive-agents/tree/main/packages/fairgive-grant-reports#readme",
  "bugs": {
    "url": "https://github.com/fpavia111-creator/fairgive-agents/issues"
  },
  "keywords": [
    "mcp",
    "mcp-server",
    "nonprofit",
    "nonprofits",
    "fundraising",
    "fairgive",
    "grant-reporting",
    "deadlines",
    "grant-management"
  ]
}
