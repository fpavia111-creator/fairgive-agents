{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.fpavia111-creator/fairgive-lapsed-donors",
  "title": "Fairgive Lapsed Donors",
  "description": "Fairgive Lapsed Donors: lists donors who gave last year but not this year (LYBUNT) and in an…",
  "version": "0.1.0",
  "repository": {
    "url": "https://github.com/fpavia111-creator/fairgive-agents",
    "source": "github",
    "subfolder": "packages/fairgive-lapsed-donors"
  },
  "websiteUrl": "https://fair-agents.com/fairgive.html",
  "packages": [
    {
      "registryType": "npm",
      "identifier": "fairgive-lapsed-donors",
      "version": "0.1.0",
      "transport": {
        "type": "stdio"
      },
      "packageArguments": [
        {
          "type": "positional",
          "value": "mcp"
        },
        {
          "type": "named",
          "name": "--root",
          "description": "Folder holding the exports this agent may read and write (it cannot reach outside it)",
          "isRequired": true,
          "format": "filepath",
          "valueHint": "exports_folder"
        }
      ]
    }
  ]
}
