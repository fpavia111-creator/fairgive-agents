{
  "name": "fairgive-lapsed-donors",
  "version": "0.1.0",
  "description": "Fairgive Lapsed Donors: lists donors who gave last year but not this year (LYBUNT) and in an earlier year but not this one (SYBUNT), with retention, upgrades and downgrades by fiscal year. Reads your gift export only. Never contacts anyone.",
  "type": "module",
  "license": "MIT",
  "author": "Kurt Francisco",
  "engines": {
    "node": ">=20"
  },
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./package.json": "./package.json"
  },
  "bin": {
    "fairgive-lapsed-donors": "bin/fairgive-lapsed-donors.js"
  },
  "files": [
    "src",
    "bin",
    "fixtures",
    "evals",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node scripts/run-tests.cjs",
    "demo": "node bin/fairgive-lapsed-donors.js demo",
    "eval": "node bin/fairgive-lapsed-donors.js eval"
  },
  "dependencies": {
    "fairgive-core": "^0.1.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fpavia111-creator/fairgive-agents.git",
    "directory": "packages/fairgive-lapsed-donors"
  },
  "homepage": "https://github.com/fpavia111-creator/fairgive-agents/tree/main/packages/fairgive-lapsed-donors#readme",
  "bugs": {
    "url": "https://github.com/fpavia111-creator/fairgive-agents/issues"
  },
  "keywords": [
    "mcp",
    "mcp-server",
    "nonprofit",
    "nonprofits",
    "fundraising",
    "fairgive",
    "lybunt",
    "sybunt",
    "donor-retention"
  ]
}
