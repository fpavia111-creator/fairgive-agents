    ".": "./src/index.js",
    "./package.json": "./package.json"
  },
  "bin": {
    "fairgive-duplicate-donors": "bin/fairgive-duplicate-donors.js"
  },
  "files": [
    "src",
    "bin",
    "fixtures",
    "evals",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "server.json"
  ],
  "scripts": {
    "test": "node scripts/run-tests.cjs",
    "demo": "node bin/fairgive-duplicate-donors.js demo",
    "eval": "node bin/fairgive-duplicate-donors.js eval"
