    "./package.json": "./package.json"
  },
  "bin": {
    "fairgive-processor-fees": "bin/fairgive-processor-fees.js"
  },
  "files": [
    "src",
    "bin",
    "fixtures",
    "evals",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
