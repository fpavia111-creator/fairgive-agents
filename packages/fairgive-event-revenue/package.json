    "./package.json": "./package.json"
  },
  "bin": {
    "fairgive-event-revenue": "bin/fairgive-event-revenue.js"
  },
  "files": [
    "src",
    "bin",
    "fixtures",
    "evals",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node scripts/run-tests.cjs",
    "demo": "node bin/fairgive-event-revenue.js demo",
    "eval": "node bin/fairgive-event-revenue.js eval"
  },
  "dependencies": {
    "fairgive-core": "^0.1.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fpavia111-creator/fairgive-agents.git",
    "directory": "packages/fairgive-event-revenue"
  },
